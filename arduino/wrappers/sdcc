#!/bin/sh
set -eu

# The Linux publication may be launched through a bin-directory alias or an
# individual command symlink. Resolve both before locating sibling payloads.
stcxx_wrapper_path=$(readlink -f -- "$0")
bin_dir=$(CDPATH= cd -- "$(dirname -- "$stcxx_wrapper_path")" && pwd -P)
tool_root=$(CDPATH= cd -- "${bin_dir}/.." && pwd -P)
export PATH="${bin_dir}:${tool_root}/libexec:${PATH}"
export SDCC_HOME="${tool_root}/share/sdcc"
exec "${tool_root}/libexec/sdcc" "$@"
