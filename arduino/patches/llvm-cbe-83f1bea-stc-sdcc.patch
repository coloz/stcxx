+      << "  else if (magnitude == UINT64_C(0x7ff0000000000000))\n"
+      << "    class_mask = (repr.bits & UINT64_C(0x8000000000000000)) ? "
+         "UINT32_C(0x004) : UINT32_C(0x200);\n"
+      << "  else if (magnitude == 0)\n"
+      << "    class_mask = (repr.bits & UINT64_C(0x8000000000000000)) ? "
+         "UINT32_C(0x020) : UINT32_C(0x040);\n"
+      << "  else if (magnitude < UINT64_C(0x0010000000000000))\n"
+      << "    class_mask = (repr.bits & UINT64_C(0x8000000000000000)) ? "
+         "UINT32_C(0x010) : UINT32_C(0x080);\n"
+      << "  else\n"
+      << "    class_mask = (repr.bits & UINT64_C(0x8000000000000000)) ? "
+         "UINT32_C(0x008) : UINT32_C(0x100);\n"
+      << "  return (mask & class_mask) != 0;\n"
+      << "}\n\n";
+}
