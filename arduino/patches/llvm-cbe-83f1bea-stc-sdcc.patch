+static unsigned getSTCNativeSizeTBits(const Module *M) {
+  if (!M)
+    return 0;
+
+  StringRef Triple = M->getTargetTriple();
+  if (Triple == "msp430-stc51-none-eabi")
+    return 16;
+  if (Triple == "msp430-stc-none-eabi")
+    return 32;
+  return 0;
+}
+
+static bool isSTCMemoryIntrinsic(Intrinsic::ID ID) {
+  return ID == Intrinsic::memcpy || ID == Intrinsic::memmove ||
+         ID == Intrinsic::memset;
+}
+
+static bool isNativeStringDeclaration(const Function &F) {
+  if (!F.isDeclaration())
+    return false;
+
+  StringRef Name = F.getName();
+  return Name == "memccpy" || Name == "memchr" || Name == "memcmp" ||
+         Name == "memcpy" || Name == "memmove" || Name == "memset" ||
+         Name == "memset_explicit" || Name == "strcat" ||
+         Name == "strchr" || Name == "strcmp" || Name == "strcoll" ||
+         Name == "strcpy" || Name == "strcspn" || Name == "strdup" ||
+         Name == "strlen" || Name == "strncat" || Name == "strncmp" ||
+         Name == "strncpy" || Name == "strndup" || Name == "strnlen" ||
+         Name == "strpbrk" || Name == "strrchr" || Name == "strsep" ||
+         Name == "strspn" || Name == "strstr" || Name == "strtok" ||
+         Name == "strxfrm";
+}
+
+void CWriter::validateSTCMemoryIntrinsic(CallInst &I, Intrinsic::ID ID) {
+  unsigned SizeTBits = getSTCNativeSizeTBits(TheModule);
+  if (SizeTBits == 0 || !isSTCMemoryIntrinsic(ID))
+    report_fatal_error("invalid STC memory intrinsic target", false);
+
+  if (I.arg_size() != 4)
+    report_fatal_error("invalid STC memory intrinsic operands", false);
+
+  Value *Length = I.getArgOperand(2);
+  auto *LengthTy = dyn_cast<IntegerType>(Length->getType());
+  if (!LengthTy)
+    report_fatal_error(
+        "STC memory intrinsic length does not match native size_t", false);
+
+  unsigned LengthBits = LengthTy->getBitWidth();
+  if (LengthBits != SizeTBits) {
+    auto *ConstantLength = dyn_cast<ConstantInt>(Length);
+    if (LengthBits <= SizeTBits || !ConstantLength)
+      report_fatal_error(
+          LengthBits > SizeTBits
+              ? "STC memory intrinsic dynamic length cannot be narrowed to "
+                "native size_t"
+              : "STC memory intrinsic length does not match native size_t",
+          false);
+    if (ConstantLength->getValue().getActiveBits() > SizeTBits)
+      report_fatal_error(
+          "STC memory intrinsic constant length exceeds native size_t", false);
+  }
+
+  auto *IsVolatile = dyn_cast<ConstantInt>(I.getArgOperand(3));
+  if (!IsVolatile || !IsVolatile->isZero())
+    report_fatal_error("volatile STC memory intrinsic is unsupported", false);
+}
