+static bool isUndefFreeScalarGraph(const Value *Root) {
+  SmallPtrSet<const Value *, 32> Seen;
+  SmallVector<const Value *, 32> Work{Root};
+  while (!Work.empty()) {
+    const Value *V = Work.pop_back_val();
+    if (!Seen.insert(V).second)
+      continue;
+    if (!V->getType()->isIntegerTy() && !V->getType()->isFloatingPointTy())
+      return false;
+    if (isGuaranteedNotToBeUndef(V))
+      continue;
+    const auto *I = dyn_cast<Instruction>(V);
+    // These scalar operations may produce poison, but cannot introduce undef
+    // bits from undef-free operands. FPToSI/UI are deliberately included:
+    // their out-of-range result is poison, not undef. Poison safety is proved
+    // separately at Root; this walk alone never licenses removing a freeze.
+    if (!I || !(isa<PHINode>(I) || isa<BinaryOperator>(I) || isa<CastInst>(I) ||
+                isa<CmpInst>(I) || isa<SelectInst>(I) ||
+                I->getOpcode() == Instruction::FNeg))
+      return false;
+    for (const Value *Operand : I->operands())
+      Work.push_back(Operand);
+  }
+  return true;
+}
+
+static bool hasProvenScalarNoWrap(const Instruction *I) {
+  const auto *BO = dyn_cast<BinaryOperator>(I);
+  if (!BO || !BO->getType()->isIntegerTy() ||
+      (BO->getOpcode() != Instruction::Add &&
+       BO->getOpcode() != Instruction::Mul))
+    return false;
+  // A narrow induction PHI widened with zext has a useful upper bound even
+  // when ValueTracking cannot prove that the entire cyclic graph is defined.
+  // Prove flags from those bounds; never erase potentially overflowing flags.
+  KnownBits L = computeKnownBits(BO->getOperand(0), I->getDataLayout());
+  KnownBits R = computeKnownBits(BO->getOperand(1), I->getDataLayout());
+  APInt MaxL = L.getMaxValue(), MaxR = R.getMaxValue();
+  bool Overflow;
+  APInt Max = BO->getOpcode() == Instruction::Add ?
+      MaxL.uadd_ov(MaxR, Overflow) : MaxL.umul_ov(MaxR, Overflow);
+  if (Overflow)
+    return false;
+  if (BO->hasNoSignedWrap()) {
+    APInt SignedMax = APInt::getSignedMaxValue(Max.getBitWidth());
+    if (MaxL.ugt(SignedMax) || MaxR.ugt(SignedMax) || Max.ugt(SignedMax))
+      return false;
+  }
+  return true;
+}
+
+static bool isDefinedScalarGraph(const FreezeInst &Freeze) {
+  // A later comparison/branch on the *unfrozen* loop value can make poison
+  // immediately undefined even across intervening stores. LLVM's analysis
+  // also checks that execution cannot exit implicitly before that use. Undef
+  // does not propagate like poison, so it needs its own independent proof.
+  if (const auto *I = dyn_cast<Instruction>(Freeze.getOperand(0)))
+    if (programUndefinedIfPoison(I) && isUndefFreeScalarGraph(I))
+      return true;
+
+  // Extend ValueTracking's bounded recursion to loop-carried scalar PHIs.
+  // Every leaf must be defined and every operation must preserve definedness,
+  // including its nuw/nsw/exact flags. The PHI SCC is then safe by induction.
+  SmallPtrSet<const Value *, 32> Seen;
+  SmallPtrSet<const Value *, 8> RequiredDefined;
+  SmallPtrSet<const Value *, 8> RequiredNonPoison;
+  // An immediately following division requires a defined divisor, even if
+  // ValueTracking cannot see through the loop's PHI and range-select flags.
+  // Stop before calls/side effects: later execution must be unavoidable.
+  for (auto It = Freeze.getIterator(); It != Freeze.getParent()->end(); ++It) {
+    if (isa<CallBase>(*It) || It->mayHaveSideEffects())
+      break;
+    SmallVector<const Value *, 4> Operands;
+    getGuaranteedWellDefinedOps(&*It, Operands);
+    RequiredDefined.insert(Operands.begin(), Operands.end());
+    Operands.clear();
+    getGuaranteedNonPoisonOps(&*It, Operands);
+    RequiredNonPoison.insert(Operands.begin(), Operands.end());
+  }
+  SmallVector<const Value *, 32> Work{Freeze.getOperand(0)};
+  while (!Work.empty()) {
+    const Value *V = Work.pop_back_val();
+    if (!Seen.insert(V).second)
+      continue;
+    if (!V->getType()->isIntegerTy() && !V->getType()->isFloatingPointTy())
+      return false;
+    if (RequiredDefined.contains(V) || isGuaranteedNotToBeUndefOrPoison(V))
+      continue;
+    const auto *Inst = dyn_cast<Instruction>(V);
+    if (!Inst || !(isa<PHINode>(Inst) || isa<BinaryOperator>(Inst) ||
+                   isa<CastInst>(Inst) || isa<CmpInst>(Inst) ||
+                   isa<SelectInst>(Inst)))
+      return false;
+    if (canCreateUndefOrPoison(cast<Operator>(Inst),
+                             !RequiredNonPoison.contains(V)) &&
+        !hasProvenScalarNoWrap(Inst))
+      return false;
+    for (const Value *Operand : Inst->operands())
+      Work.push_back(Operand);
+  }
+  return true;
+}
+
+void CWriter::visitFreezeInst(FreezeInst &I) {
+  CurInstr = &I;
+  if (!isDefinedScalarGraph(I))
+    errorWithMessage("freeze operand is not proven defined");
+  writeOperand(I.getOperand(0));
+}
