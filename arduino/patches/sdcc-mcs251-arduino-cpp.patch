+  for (destination = 0; destination < size; ++destination)
+    for (source = destination + 1; source < size; ++source)
+      {
+        if (source < leftAop->size &&
+            mcs251ArithmeticSameStorageByte (resultAop, destination,
+                                             leftAop, source))
+          return TRUE;
+        if (source < rightAop->size &&
+            mcs251ArithmeticSameStorageByte (resultAop, destination,
+                                             rightAop, source))
+          return TRUE;
+      }
+
+  return FALSE;
+}
